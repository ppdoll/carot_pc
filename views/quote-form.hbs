<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>중고 PC 견적 비교</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <div>
          <p class="eyebrow">KR Tools · Carot PC</p>
          <h1>중고 PC 견적 비교</h1>
        </div>
        <a class="secondary-link" href="/daangn/snapshots">저장된 스냅샷</a>
      </header>

      <section class="panel">
        {{#if error}}
          <div class="alert">{{error}}</div>
        {{/if}}

        <form method="get" action="/daangn/quotes/analyze" class="quote-form">
          <label for="url">당근 판매글 URL</label>
          <div class="input-row">
            <input
              id="url"
              name="url"
              value="{{url}}"
              placeholder="{{exampleUrl}}"
              required
            />
            <button type="submit">분석 실행</button>
          </div>
        </form>
      </section>
      <section class="panel">
        <p>
          <a class="secondary-link" href="/about.html">서비스 소개</a>
          |
          <a class="secondary-link" href="/privacy.html">개인정보처리방침</a>
        </p>
      </section>
    </main>
  </body>
</html>
