<style>
  .layout-outer {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 14px;
  }
  .ad-sidebar {
    width: 160px;
    flex-shrink: 0;
    position: sticky;
    top: 20px;
    display: none;
  }
  .adfit-slot {
    display: flex;
    justify-content: center;
    overflow: hidden;
  }
  .adfit-title { margin-bottom: 20px; }
  .adfit-bottom { margin-top: 24px; }
</style>
<script>
  (() => {
    const W = window.innerWidth;
    const isMobile = W <= 760;
    const hasSidebar = W >= 1540;
    const KAS_SRC = '//t1.kakaocdn.net/kas/static/ba.min.js';

    function renderAd(el, unit, w, h) {
      el.innerHTML =
        '<ins class="kakao_ad_area" style="display:none;"' +
        ' data-ad-unit="' + unit + '"' +
        ' data-ad-width="' + w + '"' +
        ' data-ad-height="' + h + '"></ins>';
    }

    for (const el of document.querySelectorAll('[data-adfit="title"]')) {
      if (isMobile) {
        renderAd(el, 'DAN-ViixzmBVJyutRwdr', 320, 480);
      } else if (!hasSidebar) {
        renderAd(el, 'DAN-qjyRzYzSoVnD6g7I', 728, 90);
      }
    }

    for (const el of document.querySelectorAll('[data-adfit="bottom"]')) {
      if (isMobile) {
        renderAd(el, 'DAN-bXlRZAFAr2gSue9r', 320, 50);
      } else {
        renderAd(el, 'DAN-qjyRzYzSoVnD6g7I', 728, 90);
      }
    }

    if (!isMobile && hasSidebar) {
      for (const el of document.querySelectorAll('[data-adfit="sidebar"]')) {
        el.style.display = 'block';
        renderAd(el, 'DAN-znU5nKHoIS7yBu4S', 160, 600);
      }
    }

    if (!document.querySelector('script[src="' + KAS_SRC + '"]')) {
      const s = document.createElement('script');
      s.type = 'text/javascript';
      s.src = KAS_SRC;
      s.async = true;
      document.body.appendChild(s);
    }
  })();
</script>
